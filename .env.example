# Copier en .env pour surcharger les valeurs par défaut de docker-compose.yml.
# Ne JAMAIS committer le fichier .env.

# development | test | production (en production, les secrets dev-only-* sont refusés)
XAALIS_ENVIRONMENT=development
XAALIS_LOG_LEVEL=INFO

POSTGRES_PASSWORD=change-me

# Pepper du hachage des clés d'API (HMAC-SHA-256). Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
XAALIS_API_KEY_PEPPER=
# Secret de signature des JWT administrateur, 32 caractères minimum (même commande).
XAALIS_JWT_SECRET=

# Jeu de démonstration (service migrate). Compte admin : admin@xaalis.example
XAALIS_SEED_ADMIN_PASSWORD=
# Facultatif : imposer les clés de test du marchand de démo (format pk_test_/sk_test_
# suivi de 32 caractères alphanumériques). Vides : générées et affichées dans les logs.
XAALIS_DEMO_TEST_PUBLISHABLE_KEY=
XAALIS_DEMO_TEST_SECRET_KEY=

# Scoring de risque gRPC (ADR 0013) : montant maximal accepté si le service ne répond pas.
XAALIS_RISK_FAIL_OPEN_MAX_AMOUNT=100000

# Observabilité (ADR 0014) : traces OpenTelemetry vers Jaeger, compte admin de Grafana.
XAALIS_OTEL_ENABLED=true
GRAFANA_ADMIN_PASSWORD=
